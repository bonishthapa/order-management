# Copy to backend/.env for local development (read by docker-compose or exported in your shell).
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://erp:erp@localhost:5433/erp
DJANGO_TIME_ZONE=Asia/Kathmandu
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=erp@localhost
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
LOG_LEVEL=INFO
# LOG_FORMAT=json   # default: json when DEBUG is off
