# docker-compose settings. Copy to .env and replace every secret.
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=replace-with-a-strong-password
DJANGO_SECRET_KEY=replace-with-50-plus-random-characters
# Public URL users open in the browser (used for CSRF/CORS and password-reset links).
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Behind HTTPS set these to 1 / 31536000 / 1:
DJANGO_SECURE_PROXY_SSL=0
DJANGO_HSTS_SECONDS=0
REFRESH_COOKIE_SECURE=0
GUNICORN_WORKERS=3
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
